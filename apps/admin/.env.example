# The operator console. Deploy this SEPARATELY from the web app, and do not put
# it on a customer-facing domain.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# This is the difference between the two apps. The web app must never have it;
# here it is used for exactly one thing, minting a session for a user whose
# account an operator has recorded a reason for opening.
SUPABASE_SERVICE_ROLE_KEY=

# Where a support session lands: the customer app's origin. The generated link
# redirects to {NEXT_PUBLIC_APP_URL}/auth/confirm, which must also be in
# Supabase → Authentication → URL Configuration → Redirect URLs.
NEXT_PUBLIC_APP_URL=https://your-web-app.vercel.app
