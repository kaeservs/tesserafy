# Copy to `.env` at the repository root for the operator scripts, and fill in.
# Never commit the filled copy — `.env` is gitignored.
#
#   pnpm env:check      says what is set, what is missing, and which project
#                       the scripts will talk to. Prints no secrets.
#
# Every `pnpm <script>` loads this file on its own. A variable already set in
# your shell wins over the file, so a one-off `SUPABASE_URL=… pnpm qa` still
# works.
#
# The apps do NOT read this file. They have their own:
#   apps/web/.env.local     NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
#   apps/admin/.env.local   the same two, plus SUPABASE_SERVICE_ROLE_KEY and NEXT_PUBLIC_APP_URL
# See apps/admin/.env.example.

# ---- Supabase: the project the scripts operate on -----------------------
# This is production. `pnpm erase --purge` with these set needs no further
# typing to delete real data; `pnpm env:check` shows the host before you run it.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Bypasses Row Level Security. Scripts and apps/admin only — the retrieval
# guard fails CI if it appears in any other app.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Schema types (pnpm db:types) ---------------------------------------
# A personal access token, not a project key: Supabase → Account → Access Tokens.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_ID=<project-ref>

# ---- Support sessions (pnpm support) ------------------------------------
# Must be a row in public.platform_admins. See apps/admin/README.md.
SUPPORT_ADMIN_EMAIL=

# ---- Anthropic -----------------------------------------------------------
ANTHROPIC_API_KEY=

# ---- The deployed web app, for pnpm qa ----------------------------------
TESSERAFY_URL=https://<your-web-app>.vercel.app

# ---- Tracker tokens (the web app's Vercel environment, not this file) -----
# Each company's tracker token is sealed with this key before it is stored
# (ADR 0015). It belongs in the web app's Vercel environment and nowhere else:
# no operator script reads it. 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing or changing it means every company reconnects its tracker.
# TRACKER_TOKEN_KEY=

# ---- Web research for call preps (the web app's Vercel environment) -----
# With a token, a call prep can look the person up on LinkedIn and search for
# news on their company, through Apify (apps/web/lib/apify.ts). Without it,
# preps work from what the seller pastes. LinkedIn's terms forbid automated
# collection of profiles; turning this on is the platform owner's decision.
# The actors are settings because community actors come and go.
# APIFY_TOKEN=
# APIFY_LINKEDIN_ACTOR=dev_fusion~linkedin-profile-scraper
# APIFY_SEARCH_ACTOR=apify~google-search-scraper

# ---- Local models --------------------------------------------------------
# Only scripts/detect.ts (a local-model spike) reads this. Embeddings no longer
# need a local model: they run in Supabase (supabase/functions/embed).
OLLAMA_URL=http://127.0.0.1:11434

# ---- Integration tests: NOT in this file ---------------------------------
# `pnpm test:integration` reads SUPABASE_URL too, but means the local stack
# from `pnpm exec supabase start`, and refuses any other host. Set those in the
# shell for that run rather than here — a production SUPABASE_URL in this file
# makes the integration tests refuse to start, which is the intended failure.
#
#   SUPABASE_URL=http://127.0.0.1:54321 SUPABASE_ANON_KEY=… \
#   SUPABASE_SERVICE_ROLE_KEY=… pnpm test:integration
#
# Speech-to-text variables are not listed: nothing reads them until spike S2
# picks a provider.

# Where the lawyer-written Terms of Service and Privacy Policy are published
# (https only). Until set, /terms and /privacy say they are being finalised.
# Web app (Vercel).
TERMS_URL=
PRIVACY_URL=
