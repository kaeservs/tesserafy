{
  // The browser suite is not covered by the packages' own typechecks and is
  // run on a schedule rather than on every PR, so without this a spec that no
  // longer compiles would stay broken until the next nightly run told us.
  //
  // Named tsconfig.json and kept beside the specs so the linter's project
  // service finds it. As tsconfig.e2e.json at the root it was invisible, and
  // every spec fell into the default project, which caps at eight files — the
  // fifth spec pushed the total over and failed lint in CI.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    // evaluateAll runs its callback inside the page, so the spec names DOM
    // types even though the suite itself runs in Node.
    "lib": ["es2024", "DOM"],
    "noEmit": true
  },
  "include": ["**/*.ts", "../playwright.config.ts"]
}
