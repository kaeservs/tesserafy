# Copy to .env.local and fill in. Never commit the filled copy.

# ---- Supabase ----------------------------------------------------------
# Project URL and publishable key are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Service role key bypasses Row Level Security. Server-side only.
# Never import this into anything under apps/web/app or apps/desktop.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Integration tests (local stack only) -------------------------------
# From `pnpm exec supabase status`. The tests refuse any non-localhost URL.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Anthropic ---------------------------------------------------------
ANTHROPIC_API_KEY=

# ---- Local models ------------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=nomic-embed-text

# ---- Speech to text (Phase 6, pending spike S2) ------------------------
STT_PROVIDER=
STT_API_KEY=
