{
  "name": "tesserafy",
  "version": "0.0.0",
  "private": true,
  "description": "Turn every conversation into product intelligence.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @tesserafy/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:integration": "pnpm -r test:integration",
    "typecheck": "pnpm -r typecheck && tsc -p scripts/tsconfig.json && tsc -p tsconfig.e2e.json",
    "lint": "node tools/lint/node_modules/eslint/bin/eslint.js --config tools/lint/eslint.config.js .",
    "guard:retrieval": "node scripts/check-retrieval-guard.mjs",
    "ingest": "tsx --env-file-if-exists=.env scripts/ingest.ts",
    "ingest:batch": "tsx --env-file-if-exists=.env scripts/ingest-batch.ts",
    "make:transcripts": "tsx --env-file-if-exists=.env scripts/make-load-transcripts.ts",
    "insights": "tsx --env-file-if-exists=.env scripts/insights.ts",
    "extract": "tsx --env-file-if-exists=.env scripts/extract.ts",
    "detect": "tsx --env-file-if-exists=.env scripts/detect.ts",
    "score": "tsx --env-file-if-exists=.env scripts/score.ts",
    "process": "tsx --env-file-if-exists=.env scripts/process.ts",
    "criteria": "tsx --env-file-if-exists=.env scripts/criteria.ts",
    "erase": "tsx --env-file-if-exists=.env scripts/erase.ts",
    "support": "tsx --env-file-if-exists=.env scripts/support.ts",
    "measure:t1": "tsx --env-file-if-exists=.env scripts/measure-t1.ts",
    "qa": "tsx --env-file-if-exists=.env scripts/qa.ts",
    "health": "tsx --env-file-if-exists=.env scripts/health.ts",
    "env:check": "tsx --env-file-if-exists=.env scripts/env-check.ts",
    "e2e": "playwright test",
    "smoke:tiers": "tsx --env-file-if-exists=.env scripts/smoke-tiers.ts",
    "costs": "tsx --env-file-if-exists=.env scripts/costs.ts",
    "db:types": "tsx --env-file-if-exists=.env scripts/db-types.ts"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "@playwright/test": "^1.63.0",
    "@tesserafy/ai": "workspace:*",
    "@tesserafy/db": "workspace:*",
    "@tesserafy/ingest": "workspace:*",
    "@tesserafy/scoring": "workspace:*",
    "@types/node": "26.5.1",
    "supabase": "2.117.0",
    "tsx": "^4.23.13",
    "typescript": "7.0.2"
  }
}
